{
  "name": "@adofai-mod-manager/frontend",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./scripts/biome-checks.mjs && bun scripts/run-vitest.mjs",
    "biome": "bun scripts/biome.mjs",
    "check": "bun run typecheck && bun run biome check --reporter=concise .. && bun run test",
    "format": "bun run biome check --write ..",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421 --strictPort"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/noto-emoji": "^5.3.2",
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "4.1.4",
    "@hugeicons/react": "^1.1.6",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "i18next": "^25.10.10",
    "motion": "^12.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^6.0.3",
    "vite": "^7.2.7",
    "vitest": "^3.2.4"
  }
}
