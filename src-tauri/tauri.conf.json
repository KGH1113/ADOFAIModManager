{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADOFAI Mod Manager",
  "version": "0.2.0",
  "identifier": "com.kgh.ADOFAIModManager",
  "build": {
    "beforeDevCommand": "bun run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run frontend:build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "ADOFAI Mod Manager", "width": 1120, "height": 780, "minWidth": 900, "minHeight": 560, "maxWidth": 1240, "maxHeight": 860, "resizable": true, "maximizable": false, "visible": false, "fullscreen": false, "titleBarStyle": "Overlay", "hiddenTitle": true, "backgroundColor": "#090d16", "dragDropEnabled": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https://api.tuforums.com; font-src 'self'; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/UMMInstallerEngine"],
    "resources": { "resources/UMMPayload/": "UMMPayload/", "../Resources/ThirdPartyNotices/": "ThirdPartyNotices/" },
    "fileAssociations": [{ "ext": ["zip"], "name": "UMM Mod Archive", "role": "Viewer" }],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" },
    "windows": { "nsis": { "displayLanguageSelector": true, "languages": ["Korean", "English", "SimpChinese"] } }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxNzAzMzE2Qjc3Qjk3QzcKUldUSGwzdTNGak53WVkyL3ptbUIxZmM1ZHM5VEJNYjR3TFcySzZHM2k5SU1rcTNuZXFqK0IwUlIK",
      "endpoints": ["https://github.com/KGH1113/ADOFAIModManager/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
