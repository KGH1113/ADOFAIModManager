<Page
    x:Class="ADOFAIModManager.Windows.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragOver="Page_DragOver"
    DragLeave="Page_DragLeave"
    Drop="Page_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="32,28,32,20" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding Localization[Mods_Title], Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{Binding Localization[Mods_Subtitle], Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding Localization[Mods_Refresh], Mode=OneWay}" Click="Refresh_Click" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="{Binding Localization[Mods_OpenFolder], Mode=OneWay}" Click="OpenFolder_Click" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="{Binding Localization[Mods_Add], Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}"
                    Click="AddMod_Click" VerticalAlignment="Center" />
        </Grid>

        <ListView Grid.Row="1" ItemsSource="{Binding Mods}" SelectionMode="None" Padding="24,0,24,24">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12" ColumnSpacing="14" MinHeight="72">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton
                            IsChecked="{Binding Enabled, Mode=OneWay}"
                            Click="ModToggle_Click"
                            Content="{Binding ToggleLabel, Mode=OneWay}"
                            VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Version}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Id}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding RequirementSummary}" FontSize="12"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Visibility="{Binding RequirementVisibility}" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="{Binding Localization[Mods_Delete], Mode=OneWay}"
                                Click="DeleteMod_Click" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{ThemeResource SmokeFillColorDefaultBrush}">
            <Border Padding="36,30" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE74D;" FontSize="42" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Localization[Mods_Drop], Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
