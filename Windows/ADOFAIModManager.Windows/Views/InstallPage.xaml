<Page
    x:Class="ADOFAIModManager.Windows.Views.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,28" Spacing="24" MaxWidth="820" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock Text="ADOFAI Mod Manager" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="얼불춤에 UMM을 설치하고 모드를 관리합니다."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Padding="22" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="얼불춤" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding GameLocationText, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GameDirectory, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="게임 폴더 선택" Click="ChooseGame_Click" VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="UMM" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding UmmStatusText, Mode=OneWay}" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar
                IsOpen="{Binding HasInstallWarning, Mode=OneWay}"
                IsClosable="False"
                Severity="Warning"
                Title="설치 상태를 확인해야 합니다"
                Message="설치 문제 해결을 실행하면 필요한 파일을 다시 확인합니다." />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{Binding PrimaryInstallText, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}"
                        IsEnabled="{Binding CanInstall, Mode=OneWay}" Click="Install_Click" />
                <Button Content="더 보기">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="상태 다시 확인" Click="Refresh_Click" />
                            <MenuFlyoutItem Text="설치 문제 해결" Click="Repair_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="UMM 제거" Click="Remove_Click" />
                            <MenuFlyoutItem Text="설치 전 상태로 되돌리기" Click="Restore_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <TextBlock Text="일반적으로 관리자 권한은 필요하지 않습니다. 게임이 실행 중이면 먼저 종료해 주세요."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
