<Page
    x:Class="ADOFAIModManager.Windows.Views.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,28" Spacing="24" MaxWidth="820" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock Text="ADOFAI Mod Manager" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{Binding Localization[Install_Subtitle], Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Padding="22" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Localization[Install_Game], Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding GameLocationText, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GameDirectory, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding Localization[Install_ChooseFolder], Mode=OneWay}" Click="ChooseGame_Click" VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="UMM" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding UmmStatusText, Mode=OneWay}" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar
                IsOpen="{Binding HasInstallWarning, Mode=OneWay}"
                IsClosable="False"
                Severity="Warning"
                Title="{Binding Localization[Install_WarningTitle], Mode=OneWay}"
                Message="{Binding Localization[Install_WarningMessage], Mode=OneWay}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{Binding PrimaryInstallText, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}"
                        IsEnabled="{Binding CanInstall, Mode=OneWay}" Click="Install_Click" />
                <Button Content="{Binding Localization[Install_More], Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{Binding Localization[Install_Refresh], Mode=OneWay}" Click="Refresh_Click" />
                            <MenuFlyoutItem Text="{Binding Localization[Install_Repair], Mode=OneWay}" Click="Repair_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{Binding Localization[Install_Remove], Mode=OneWay}" Click="Remove_Click" />
                            <MenuFlyoutItem Text="{Binding Localization[Install_Restore], Mode=OneWay}" Click="Restore_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding Localization[Install_Note], Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
