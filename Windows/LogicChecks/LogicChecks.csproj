<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ADOFAIModManager.Windows\Application\**\*.cs" Link="Application\%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <ProjectReference Include="..\..\Engine\NativeUmm.Infrastructure\NativeUmm.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\ADOFAIModManager.Windows\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\ADOFAIModManager.Windows\Services\*.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\ADOFAIModManager.Windows\ViewModels\*.cs" Link="ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\ADOFAIModManager.Windows\Features\**\*.cs" Link="Features\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ADOFAIModManager.Windows\Infrastructure\**\*.cs" Link="Infrastructure\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ADOFAIModManager.Windows\Views\DiscordMessageRenderer.cs" Link="Views\DiscordMessageRenderer.cs" />
    <Compile Include="..\ADOFAIModManager.Windows\Views\ModImportWorkflow.cs" Link="Views\ModImportWorkflow.cs" />
    <Compile Include="..\ADOFAIModManager.Windows\Views\CatalogPage.xaml.cs" Link="Views\CatalogPage.xaml.cs" />
  </ItemGroup>
</Project>
